{
  "name": "attackship",
  "version": "1.0.0",
  "private": true,
  "description": "Attackship camp game MERN application",
  "scripts": {
    "client": "npm run dev --prefix client",
    "server": "npm run dev --prefix server",
    "dev": "concurrently -n SERVER,CLIENT -c auto \"npm run server\" \"npm run client\"",
    "install-all": "npm install --prefix server && npm install --prefix client",
    "build": "npm run build --prefix client",
    "start": "npm start --prefix server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
